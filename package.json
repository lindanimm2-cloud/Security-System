{
  "name": "4ds-solutions-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @4ds-solutions/api",
    "dev:admin": "npm run dev -w @4ds-solutions/admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate -w @4ds-solutions/api",
    "db:seed": "npm run prisma:seed -w @4ds-solutions/api",
    "setup": "npm install && npm run db:up && npm run db:migrate && npm run db:seed"
  },
  "engines": {
    "node": ">=20"
  }
}
