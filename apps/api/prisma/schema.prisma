  CONNECTED
  ON_HOLD
  ENDED
  MISSED
  DECLINED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
}

enum PropertyType {
  HOUSE
  APARTMENT
  TOWNHOUSE
  ESTATE
  BUSINESS
}

enum AlarmStatus {
  ARMED
  DISARMED
  TRIGGERED
  OFFLINE
  STAY
  NIGHT
  EXIT_DELAY
  ENTRY_DELAY
}

enum CameraStatus {
  ONLINE
  OFFLINE
  FAULT
  RECORDING
}

enum CameraPlacement {
  EXTERIOR
  INTERIOR
}

enum SensorType {
  PIR
  DOOR_CONTACT
  WINDOW_CONTACT
  GLASS_BREAK
  SMOKE
  HEAT
  GAS
  WATER_LEAK
  PANIC_BUTTON
  MEDICAL_BUTTON
  FIRE_BUTTON
  OUTDOOR_BEAM
  ELECTRIC_FENCE
  VIBRATION
  KEYPAD
  SIREN
  OTHER
}

enum SensorStatus {
  NORMAL
  OPEN
