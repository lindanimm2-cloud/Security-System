  MEDICAL
  FIRE
}

enum NotificationPriority {
  P0
  P1
  P2
  P3
}

enum ErrorReportStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum MessageAttachmentKind {
  IMAGE
  VIDEO
  FILE
}

enum CallChannel {
  INTERNAL
  WHATSAPP
  DISPATCH_LINE
  EXTERNAL
}

