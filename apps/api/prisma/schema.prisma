enum CompanyVehicleType {
  PATROL
  ARMED_RESPONSE
  MOTORCYCLE
  MEDICAL
  FIRE_TRUCK
  TACTICAL
  UNMARKED
}

enum CompanyVehicleStatus {
  AVAILABLE
  DEPLOYED
  EN_ROUTE
  ON_SCENE
  MAINTENANCE
  OFFLINE
}

enum VehicleCrewRole {
  DRIVER
  PASSENGER
  SUPERVISOR
}

enum DocumentCategory {
  INCIDENT_EVIDENCE
  DISPATCH_REPORT
  CLIENT_RECORD
  OFFICER_REPORT
  POLICY_SOP
  LEGAL_COMPLIANCE
  TRAINING
  VEHICLE_PROPERTY
  OTHER
}

enum StockRequestStatus {
  PENDING
  APPROVED
  FULFILLED
  REJECTED
}

model Tenant {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  logoUrl      String?  @map("logo_url")
  primaryColor String?  @map("primary_color")
  contactEmail String   @map("contact_email")
  contactPhone String?  @map("contact_phone")
  settings     Json     @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users              User[]
  refreshTokens      RefreshToken[]
  officers           Officer[]
  incidents          Incident[]
  incidentNotes      IncidentNote[]
  incidentEvents     IncidentEvent[]
  emergencyContacts  EmergencyContact[]
  families           Family[]
  notifications      Notification[]
  conversations      Conversation[]
  callSessions       CallSession[]
  companyVehicles    CompanyVehicle[]
  vehicles           Vehicle[]
  properties         Property[]
  cameras            Camera[]
  sensors            Sensor[]
  alarmEvents        AlarmEvent[]
  subscriptions      Subscription[]
  safeZones          SafeZone[]
  branches           Branch[]
  teams              Team[]
  documentFolders    DocumentFolder[]
  documents          Document[]
  products           Product[]
  storeOrders        StoreOrder[]
  salesLeads         SalesLead[]
  installJobs        InstallJob[]
  clientLoyalties    ClientLoyalty[]
  discountCodes      DiscountCode[]
  stockRequests      StockRequest[]
  errorReports       ErrorReport[]
  trustedDevices     TrustedDevice[]
  emergencySessions  EmergencySession[]
  panicEvents        PanicEvent[]
  securityAudits     SecurityAuditEvent[]
  securityLockdowns  SecurityLockdown[]
  securityConsents   SecurityConsent[]
  deviceSessions     DeviceSession[]

  @@map("tenants")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  email           String
  phone           String?
  passwordHash    String?    @map("password_hash")
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  avatarUrl       String?    @map("avatar_url")
  jobTitle        String?    @map("job_title")
  role            UserRole
  status          UserStatus @default(PENDING_VERIFICATION)
  branchId        String?    @map("branch_id") @db.Uuid
  lastKnownLat    Decimal?   @map("last_known_lat") @db.Decimal(10, 8)
  lastKnownLng    Decimal?   @map("last_known_lng") @db.Decimal(11, 8)
  lastLocationAt  DateTime?  @map("last_location_at")
  trackingEnabled         Boolean    @default(true) @map("tracking_enabled")
  familyMessagingEnabled  Boolean    @default(false) @map("family_messaging_enabled")
  /** Protection clients appear in CRM; store-only shoppers do not */
  isProtectionClient      Boolean    @default(false) @map("is_protection_client")
  inviteToken             String?    @unique @map("invite_token")
  inviteExpiresAt         DateTime?  @map("invite_expires_at")
  registrationCompletedAt DateTime?  @map("registration_completed_at")
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  branch            Branch?            @relation(fields: [branchId], references: [id])
  refreshTokens     RefreshToken[]
  emergencyContacts EmergencyContact[]
  incidents         Incident[]
  familyMemberships FamilyMember[]
  ownedFamilies     Family[]           @relation("FamilyOwner")
  notifications     Notification[]
  incidentEvents    IncidentEvent[]
  messages          Message[]
  medicalProfile    MedicalProfile?
  vehicles          Vehicle[]
  properties        Property[]
  subscription      Subscription?
  safeZones         SafeZone[]
  teamMemberships   TeamMember[]
  initiatedCalls    CallSession[] @relation("CallInitiator")
  receivedCalls     CallSession[] @relation("CallTarget")
  storeOrders       StoreOrder[]  @relation("StoreOrderCustomer")
  salesLeadsOwned   SalesLead[]   @relation("SalesLeadOwner")
  installJobsAssigned InstallJob[] @relation("InstallJobTechnician")
  loyalty           ClientLoyalty?
  stockRequests     StockRequest[] @relation("StockRequestRequester")
  stockReviews      StockRequest[] @relation("StockRequestReviewer")
  errorReports       ErrorReport[]
  trustedDevices     TrustedDevice[]
  emergencySessions  EmergencySession[]
  panicEvents        PanicEvent[]
  securityAudits     SecurityAuditEvent[]  @relation("SecurityAuditActor")
  securityLockdowns  SecurityLockdown[]
  securityConsents   SecurityConsent[]
  securitySettings   ClientSecuritySettings?
  deviceSessions     DeviceSession[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
}

model Officer {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  email           String
  firstName       String        @map("first_name")
  lastName        String        @map("last_name")
  status          OfficerStatus @default(OFF_DUTY)
  currentLat      Decimal?      @map("current_lat") @db.Decimal(10, 8)
  currentLng      Decimal?      @map("current_lng") @db.Decimal(11, 8)
  zone            String?
  branchId        String?       @map("branch_id") @db.Uuid
  avgResponseSec  Int           @default(300) @map("avg_response_sec")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  branch      Branch?              @relation(fields: [branchId], references: [id])
  dispatches  Dispatch[]
  vehicleCrew CompanyVehicleCrew?

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("officers")
}

model CompanyVehicle {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  registration  String
  callSign      String               @map("call_sign")
  make          String
  model         String
  color         String?
  year          Int?
  vehicleType   CompanyVehicleType   @map("vehicle_type")
  status        CompanyVehicleStatus @default(AVAILABLE)
  currentLat    Decimal?             @map("current_lat") @db.Decimal(10, 8)
  currentLng    Decimal?             @map("current_lng") @db.Decimal(11, 8)
  trackerLinked Boolean              @default(true) @map("tracker_linked")
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  tenant Tenant               @relation(fields: [tenantId], references: [id])
  crew   CompanyVehicleCrew[]
  dispatches Dispatch[]

  @@unique([tenantId, registration])
  @@unique([tenantId, callSign])
  @@index([tenantId, status])
  @@map("company_vehicles")
}

model CompanyVehicleCrew {
  id               String          @id @default(uuid()) @db.Uuid
  companyVehicleId String          @map("company_vehicle_id") @db.Uuid
  officerId        String          @unique @map("officer_id") @db.Uuid
  role             VehicleCrewRole @default(PASSENGER)
  sortOrder        Int             @default(0) @map("sort_order")
  assignedAt       DateTime        @default(now()) @map("assigned_at")

  companyVehicle CompanyVehicle @relation(fields: [companyVehicleId], references: [id], onDelete: Cascade)
  officer        Officer        @relation(fields: [officerId], references: [id], onDelete: Cascade)

  @@index([companyVehicleId, sortOrder])
  @@map("company_vehicle_crew")
}

model EmergencyContact {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String
  phone         String
  relationship  String?
  priority      Int      @default(1)
  notifyOnPanic       Boolean   @default(true) @map("notify_on_panic")
  permissionToContact Boolean   @default(true) @map("permission_to_contact")
  verifiedAt          DateTime? @map("verified_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("emergency_contacts")
}

model Family {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  ownerUserId String   @map("owner_user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  owner   User           @relation("FamilyOwner", fields: [ownerUserId], references: [id])
  members FamilyMember[]

  @@map("families")
}

model FamilyMember {
  id              String   @id @default(uuid()) @db.Uuid
  familyId        String   @map("family_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  nickname        String?
  canViewLocation Boolean  @default(true) @map("can_view_location")
  joinedAt        DateTime @default(now()) @map("joined_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@map("family_members")
}

model Incident {
  id               String                 @id @default(uuid()) @db.Uuid
  tenantId         String                 @map("tenant_id") @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  publicRef        String                 @map("public_ref")
  type             IncidentType
  classification   IncidentClassification @default(SECURITY)
  involvedAgencies String[]               @default([]) @map("involved_agencies")
  status           IncidentStatus         @default(ACTIVE)
  priority         IncidentPriority       @default(HIGH)
  title            String?
  description      String?
  lat              Decimal                @db.Decimal(10, 8)
  lng              Decimal                @db.Decimal(11, 8)
  address          String?
  propertyId       String?                @map("property_id") @db.Uuid
  vehicleId        String?                @map("vehicle_id") @db.Uuid
  vehicleMake      String?                @map("vehicle_make")
  vehicleModel     String?                @map("vehicle_model")
  vehicleColor     String?                @map("vehicle_color")
  vehiclePlate     String?                @map("vehicle_plate")
  isSilent         Boolean                @default(false) @map("is_silent")
  contextSnapshot  Json                   @default("{}") @map("context_snapshot")
  conversationId   String?                @map("conversation_id") @db.Uuid
  ackedAt          DateTime?              @map("acked_at")
  dispatchedAt     DateTime?              @map("dispatched_at")
  onSceneAt        DateTime?              @map("on_scene_at")
  resolvedAt       DateTime?              @map("resolved_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  user         User            @relation(fields: [userId], references: [id])
  property     Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  conversation Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  dispatches   Dispatch[]
  media        IncidentMedia[]
  notes        IncidentNote[]
  documents    Document[]
  events       IncidentEvent[]
  panicEvents  PanicEvent[]
  notifications Notification[]
  alarmEvents  AlarmEvent[]
  calls        CallSession[]

  @@unique([tenantId, publicRef])
  @@index([tenantId, status])
  @@index([userId])
  @@index([propertyId])
  @@index([vehicleId])
  @@map("incidents")
}

model DocumentFolder {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  description String?
  icon        String?  @default("folder")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  parent    DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocumentFolder[] @relation("FolderTree")
  documents Document[]

  @@index([tenantId, parentId])
  @@map("document_folders")
}

model Document {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  folderId    String?          @map("folder_id") @db.Uuid
  incidentId  String?          @map("incident_id") @db.Uuid
  category    DocumentCategory @default(OTHER)
  title       String
  description String?
  fileName    String           @map("file_name")
  fileType    String           @map("file_type")
  fileUrl     String           @map("file_url")
  fileSizeKb  Int?             @map("file_size_kb")
  tags        String[]         @default([])
  uploadedBy  String?          @map("uploaded_by")
  isPinned    Boolean          @default(false) @map("is_pinned")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  folder   DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  incident Incident?       @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([tenantId, folderId])
  @@index([tenantId, category])
  @@index([incidentId])
  @@map("documents")
}

model IncidentNote {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  authorRole String   @map("author_role")
  authorName String   @map("author_name")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@map("incident_notes")
}

model MedicalProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  bloodType          String?  @map("blood_type")
  allergies          String?
  medications        String?
  chronicConditions  String?  @map("chronic_conditions")
  emergencyNotes       String?  @map("emergency_notes")
  doctorContact        String?  @map("doctor_contact")
  ambulancePreference  String?  @map("ambulance_preference")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("medical_profiles")
}

model Vehicle {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  registration    String
  make            String
  model           String
  variant         String?
  year            Int?
  color           String?
  vin             String?
  engineNumber    String?   @map("engine_number")
  licenceExpiry   DateTime? @map("licence_expiry")
  insuranceInfo   String?   @map("insurance_info")
  financeProvider String?   @map("finance_provider")
  trackerLinked         Boolean   @default(false) @map("tracker_linked")
  phoneTrackingEnabled  Boolean   @default(false) @map("phone_tracking_enabled")
  theftRecovery         Boolean   @default(false) @map("theft_recovery")
  lastKnownLat    Decimal?  @map("last_known_lat") @db.Decimal(10, 8)
  lastKnownLng    Decimal?  @map("last_known_lng") @db.Decimal(11, 8)
  immobiliserOn   Boolean   @default(false) @map("immobiliser_on")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  incidents Incident[]

  @@index([userId])
  @@map("vehicles")
}

model Property {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  name               String
  address            String
  propertyType       PropertyType @default(HOUSE) @map("property_type")
  accessNotes        String?      @map("access_notes")
  gateCode           String?      @map("gate_code")
  occupantDetails    String?      @map("occupant_details")
  keyHolder          String?      @map("key_holder")
  alarmStatus        AlarmStatus  @default(DISARMED) @map("alarm_status")
  alarmLinked        Boolean      @default(false) @map("alarm_linked")
  camerasLinked      Boolean      @default(false) @map("cameras_linked")
  monitoringEnabled  Boolean      @default(true) @map("monitoring_enabled")
  /** When false, interior cameras stay private unless panic/alarm unlocks them */
  shareInteriorCameras Boolean    @default(false) @map("share_interior_cameras")
