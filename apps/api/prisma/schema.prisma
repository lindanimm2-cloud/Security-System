  status          InstallJobStatus @default(SCHEDULED)
  clientName      String           @map("client_name")
  clientPhone     String?          @map("client_phone")
  address         String
  scheduledAt     DateTime         @map("scheduled_at")
  completedAt     DateTime?        @map("completed_at")
  equipmentNotes  String?          @map("equipment_notes")
  lat             Decimal?         @db.Decimal(10, 8)
  lng             Decimal?         @db.Decimal(11, 8)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  technician User?  @relation("InstallJobTechnician", fields: [technicianId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([technicianId, status])
  @@map("install_jobs")
}

model TrustedDevice {
  id                   String              @id @default(uuid()) @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  userId               String              @map("user_id") @db.Uuid
  publicId             String              @unique @map("public_id")
  name                 String
  deviceType           String              @map("device_type")
  osName               String?             @map("os_name")
  osVersion            String?             @map("os_version")
  appVersion           String?             @map("app_version")
  userAgent            String?             @map("user_agent")
  fingerprintHash      String?             @map("fingerprint_hash")
  status               TrustedDeviceStatus @default(PENDING_VERIFICATION)
  isPrimary            Boolean             @default(false) @map("is_primary")
  isLocked             Boolean             @default(false) @map("is_locked")
  lostReason           DeviceLostReason?   @map("lost_reason")
  nativeSos            NativeSosCapability @default(NOT_AVAILABLE) @map("native_sos")
  nativeSosNote        String?             @map("native_sos_note")
  lastLat              Decimal?            @map("last_lat") @db.Decimal(10, 8)
  lastLng              Decimal?            @map("last_lng") @db.Decimal(11, 8)
  lastLocationAccuracy Float?              @map("last_location_accuracy")
  lastActiveAt         DateTime?           @map("last_active_at")
  lastAuthAt           DateTime?           @map("last_auth_at")
  lastFailedAuthAt     DateTime?           @map("last_failed_auth_at")
  registeredAt         DateTime            @default(now()) @map("registered_at")
  revokedAt            DateTime?           @map("revoked_at")
  lockedAt             DateTime?           @map("locked_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions           DeviceSession[]
  emergencySessions  EmergencySession[]
  panicEvents        PanicEvent[]
  securityEvents     DeviceSecurityEvent[]
  refreshTokens      RefreshToken[]

  @@index([userId, status])
  @@index([tenantId, status])
  @@index([publicId])
  @@map("trusted_devices")
}

model DeviceSession {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  deviceId         String    @map("device_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  ipAddress        String?   @map("ip_address")
  authMethod       String?   @map("auth_method")
  isEmergency      Boolean   @default(false) @map("is_emergency")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  expiresAt        DateTime? @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device TrustedDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceId, revokedAt])
  @@index([userId, revokedAt])
  @@map("device_sessions")
}

model EmergencySession {
  id             String                   @id @default(uuid()) @db.Uuid
  tenantId       String                   @map("tenant_id") @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  deviceId       String?                  @map("device_id") @db.Uuid
  tokenHash      String                   @unique @map("token_hash")
  purpose        EmergencySessionPurpose
  status         EmergencySessionStatus   @default(ACTIVE)
  authMethod     String                   @map("auth_method")
  ipAddress      String?                  @map("ip_address")
  actionsJson    Json                     @default("[]") @map("actions_json")
  expiresAt      DateTime                 @map("expires_at")
  revokedAt      DateTime?                @map("revoked_at")
  createdAt      DateTime                 @default(now()) @map("created_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device TrustedDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  panicEvents PanicEvent[]

  @@index([userId, status])
  @@index([tenantId, status, expiresAt])
  @@map("emergency_sessions")
}

model PanicEvent {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @map("tenant_id") @db.Uuid
  userId                String              @map("user_id") @db.Uuid
  deviceId              String?             @map("device_id") @db.Uuid
  sessionId             String?             @map("session_id") @db.Uuid
  incidentId            String?             @map("incident_id") @db.Uuid
  source                PanicSource
  workflowStatus        PanicWorkflowStatus @default(NEW) @map("workflow_status")
  transmissionStatus    String              @default("SENT") @map("transmission_status")
  idempotencyKey        String?             @map("idempotency_key")
  lat                   Decimal?            @db.Decimal(10, 8)
  lng                   Decimal?            @db.Decimal(11, 8)
  locationAccuracy      Float?              @map("location_accuracy")
  locationSource        String?             @map("location_source")
  batteryLevel          Int?                @map("battery_level")
  networkStatus         String?             @map("network_status")
  authenticated         Boolean             @default(true)
  isTest                Boolean             @default(false) @map("is_test")
  isSilent              Boolean             @default(false) @map("is_silent")
  acknowledgedAt        DateTime?           @map("acknowledged_at")
  acknowledgedByUserId  String?             @map("acknowledged_by_user_id") @db.Uuid
  dispatcherName        String?             @map("dispatcher_name")
  responseUnit          String?             @map("response_unit")
  resolvedAt            DateTime?           @map("resolved_at")
  cancellationReason    String?             @map("cancellation_reason")
  cancelRequestedAt     DateTime?           @map("cancel_requested_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    TrustedDevice?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  session   EmergencySession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  incident  Incident?           @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  history   PanicEventHistory[]

  @@unique([tenantId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([tenantId, workflowStatus, createdAt])
  @@index([incidentId])
  @@map("panic_events")
}

model PanicEventHistory {
  id          String   @id @default(uuid()) @db.Uuid
  panicEventId String  @map("panic_event_id") @db.Uuid
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   String?  @map("actor_role")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  panicEvent PanicEvent @relation(fields: [panicEventId], references: [id], onDelete: Cascade)

  @@index([panicEventId, createdAt])
  @@map("panic_event_history")
}

model DeviceSecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  deviceId  String?  @map("device_id") @db.Uuid
  type      String
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  device TrustedDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([type])
  @@map("device_security_events")
}

model SecurityLockdown {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  reason      String?
  active      Boolean   @default(true)
  activatedAt DateTime  @default(now()) @map("activated_at")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@map("security_lockdowns")
}

model SecurityAuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorRole     String?  @map("actor_role")
  accountUserId String?  @map("account_user_id") @db.Uuid
  deviceId      String?  @map("device_id") @db.Uuid
  sessionId     String?  @map("session_id") @db.Uuid
  action        String
  result        String   @default("SUCCESS")
  reason        String?
  source        String?
  target        String?
  previousState Json?    @map("previous_state")
  newState      Json?    @map("new_state")
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("SecurityAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([accountUserId, createdAt])
  @@index([action])
  @@map("security_audit_events")
}

model SecurityConsent {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  kind          SecurityConsentKind
  version       String
  policyVersion String              @map("policy_version")
  accepted      Boolean
  ipAddress     String?             @map("ip_address")
  deviceId      String?             @map("device_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("security_consents")
}

model ClientSecuritySettings {
  userId                     String               @id @map("user_id") @db.Uuid
  duressEnabled              Boolean              @default(false) @map("duress_enabled")
  duressPinHash              String?              @map("duress_pin_hash")
  panicHoldMs                Int                  @default(3000) @map("panic_hold_ms")
  emergencySessionMinutes    Int                  @default(10) @map("emergency_session_minutes")
  trackingMode               LocationTrackingMode @default(EMERGENCY_ONLY) @map("tracking_mode")
  emergencySetupCompletedAt  DateTime?            @map("emergency_setup_completed_at")
  panicTestedAt              DateTime?            @map("panic_tested_at")
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedAt                  DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_security_settings")
}

