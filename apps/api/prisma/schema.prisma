  DISPATCHER
  SUPERVISOR
  MANAGER
  TENANT_ADMIN
  OWNER
  SUPER_ADMIN
  SALES
  TECHNICIAN
  DEVELOPER
  MEDICAL_DISPATCHER
  MEDICAL_CREW
  FIRE_DISPATCHER
  FIRE_CREW
  FIRE_SUPERVISOR
}

enum ProductCategory {
  // Catalogue departments (SA security superstore)
  FIREARMS
  BODY_ARMOUR
  PERSONAL_SECURITY
  CCTV
  NVR_STORAGE
  SMART_HOME
  ALARMS
  SENSORS
  ELECTRIC_FENCING
  PERIMETER
  ACCESS_CONTROL
  GATES
  INTERCOMS
  GUARD_EQUIPMENT
  GUARD_TOUR
  VEHICLE_SECURITY
  LIGHTING
  NETWORKING
  POWER
  INSTALL_MATERIALS
  TOOLS
  TECH_EQUIPMENT
  SAFES
  LOCKS
  PHYSICAL_PERIMETER
  FIRE_SAFETY
  PACKAGES
  CONTROL_ROOM
  SIGNS
  INSPECTION
  CYBER
  SPARE_PARTS

