  EMERGENCY_LOCATION
  MEDICAL_PROFILE
  DEVICE_REGISTRATION
  PRIVACY_POLICY
}

enum ConversationType {
  INTERNAL
  SUPPORT
  OFFICER_DISPATCH
  FAMILY
  TECH_TEAM
  DEV_SUPPORT
  INCIDENT
}

enum IncidentClassification {
