}

enum AlarmEventType {
  MOTION
  INTRUSION
  CAMERA_OFFLINE
  ALARM_TRIGGERED
  TAMPER
  MANUAL
  BURGLARY
  PERIMETER
  FIRE
  MEDICAL
  PANIC
  DURESS
  AC_FAIL
  LOW_BATTERY
  FENCE_ALARM
  BEAM_ALARM
  ZONE_BYPASS
  ARM
  DISARM
  TROUBLE
