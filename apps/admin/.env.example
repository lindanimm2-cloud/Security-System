# Admin / public site (Next.js)

# Pitch / Vercel: set to true for full offline demo (no Nest API needed)
NEXT_PUBLIC_DEMO_MODE=true

# Only needed when DEMO_MODE is false
NEXT_PUBLIC_API_URL=http://localhost:4010/v1

# Production with real API:
# NEXT_PUBLIC_DEMO_MODE=false
# NEXT_PUBLIC_API_URL=https://your-api.example.com/v1
